# AeroVision Frontend Environment Variables
# In development, leave blank to use the local Vite proxy (/api -> http://127.0.0.1:8000)
# In production on Vercel/Netlify, set this to your deployed backend URL:
# e.g., https://aerovision-api.onrender.com/api or https://aerovision-api.up.railway.app/api
VITE_API_URL=

# Optional: Google Maps Platform API Key for live satellite & cockpit map layer
VITE_GOOGLE_MAPS_API_KEY=

