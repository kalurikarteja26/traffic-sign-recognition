# ==============================================================================
# AeroVision — Intelligent Road Safety & Vehicle Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Application & Environment
PROJECT_NAME="AeroVision — Intelligent Road Safety Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (Default: local SQLite database; replace with PostgreSQL in production)
# SQLite: sqlite:///./aerovision.db
# PostgreSQL: postgresql://aerovision_user:secure_password@localhost:5432/aerovision_db
DATABASE_URL=sqlite:///./aerovision.db

# Authentication & Security
# Generate a secure secret in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=aerovision_secret_key_super_secure_adas_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Configuration
MODEL_CHECKPOINT_PATH=models/rto_best.pth
NUM_CLASSES=108

# Storage & Quotas (Bytes)
DEFAULT_STORAGE_QUOTA_BYTES=524288000
MAX_UPLOAD_SIZE_BYTES=104857600

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]
